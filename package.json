{
    "name": "metajurassic",
    "version": "1.0.0",
    "description": "",
    "license": "ISC",
    "author": "",
    "type": "commonjs",
    "scripts": {
        "build": "webpack --config webpack.config.js && npm run docs:build",
        "serve": "webpack serve --config webpack.config.js",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "format": "prettier --write \"src/**/*.ts\" \"src/**/*.html\" \"e2e/**/*.ts\" \"scripts/**/*.ts\" \"docs/**/*.md\" \"docs/**/*.mts\" webpack.config.js playwright.config.ts",
        "format:check": "prettier --check \"src/**/*.ts\" \"src/**/*.html\" \"e2e/**/*.ts\" \"scripts/**/*.ts\" \"docs/**/*.md\" \"docs/**/*.mts\" webpack.config.js playwright.config.ts",
        "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.ts\" playwright.config.ts --max-warnings=0",
        "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.ts\" playwright.config.ts --fix",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "test:e2e": "playwright test",
        "og:image": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' ts-node scripts/og-image.ts",
        "playtest:difficulty": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' ts-node scripts/playtest/difficulty.ts",
        "playtest:walkthrough": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' ts-node scripts/playtest/walkthrough.ts",
        "playtest:hint": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' ts-node scripts/playtest/hint.ts",
        "test:pipeline": "python3 scripts/test_content_pipeline.py",
        "ci": "npm run format:check && npm run lint && npm run test:pipeline && npm run test:coverage && npm run test:e2e"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@playwright/test": "1.57.0",
        "@tailwindcss/postcss": "^4.1.18",
        "@types/canvas-confetti": "^1.9.0",
        "@types/eslint__js": "^8.42.3",
        "@types/jest": "^29.5.14",
        "@types/node": "^25.3.5",
        "autoprefixer": "^10.4.24",
        "copy-webpack-plugin": "^13.0.1",
        "css-loader": "^7.1.3",
        "eslint": "^9.39.4",
        "get-port": "^7.2.0",
        "html-webpack-plugin": "^5.6.6",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.4.1",
        "jest-junit": "^16.0.0",
        "postcss": "^8.5.6",
        "postcss-loader": "^8.2.0",
        "prettier": "^3.8.1",
        "style-loader": "^4.0.0",
        "tailwindcss": "^4.1.18",
        "ts-jest": "^29.4.6",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.2",
        "typescript-eslint": "^8.57.1",
        "vitepress": "^1.6.4",
        "webpack": "^5.105.1",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.2.3"
    },
    "dependencies": {
        "canvas-confetti": "^1.9.4",
        "marked": "^17.0.2"
    }
}
